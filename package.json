{
  "name": "whichtree",
  "version": "0.1.0",
  "description": "Witness which Git worktree a file reader returns across a Codex thread directory change.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "whichtree": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "evidence",
    "NOTICE.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "test:package": "node test/package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server-filesystem": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
